# name: test/sql/emeans_assign.test
# description: emeans_assign() gives the nearest centroid and the squared distance to it
# group: [emeans]

require emeans

# (1, 1) is 1 + 1 = 2 from (0, 0); (9, 9) is 2 from (10, 10); (5, 5) is 50 from both, and the tie goes
# to the lower label.
query III
SELECT emeans_assign([1, 1], [[0, 0], [10, 10]]), emeans_assign([9, 9], [[0, 0], [10, 10]]),
       emeans_assign([5, 5], [[0, 0], [10, 10]])
----
{'label': 1, 'sq_distance': 2.0}	{'label': 2, 'sq_distance': 2.0}	{'label': 1, 'sq_distance': 50.0}

# FLOAT lists, DOUBLE lists and FLOAT[2] arrays.
query III
SELECT (emeans_assign([1, 1]::FLOAT[], [[0, 0], [10, 10]]::FLOAT[][])).label,
       (emeans_assign([9.5, 9.5]::DOUBLE[], [[0, 0], [10, 10]]::DOUBLE[][])).sq_distance,
       (emeans_assign([9, 9]::FLOAT[2], [[0, 0], [10, 10]]::FLOAT[2][])).label
----
1	0.5	2

# On converged data every point's nearest centroid is the label emeans gave it.
query I
WITH f AS (SELECT x, emeans(x, 2) AS r
           FROM (SELECT [[0, 0], [0, 1], [1, 0], [1, 1], [10, 10], [10, 11], [11, 10], [11, 11]]::DOUBLE[][] AS x))
SELECT list_transform(x, lambda v: (emeans_assign(v, r.centroids)).label) = r.labels FROM f
----
true

# Row by row over a table, with the centroids from a subquery.
statement ok
CREATE TABLE pts AS SELECT i, [i, 0]::FLOAT[2] AS v FROM range(6) t(i);

query II
SELECT i, (emeans_assign(v, [[0, 0], [4, 0]]::FLOAT[][])).label FROM pts ORDER BY i
----
0	1
1	1
2	1
3	2
4	2
5	2

# Centroids that change from row to row: a row reuses the previous row's prepared centroids only when it
# points at the same list, so rows 3 and 5, with the order reversed, get label 2.
query II
SELECT i, (emeans_assign([1, 1], c)).label
FROM (VALUES (1, [[0, 0], [10, 10]]), (2, [[0, 0], [10, 10]]), (3, [[10, 10], [0, 0]]), (4, [[0, 0], [10, 10]]),
             (5, [[10, 10], [0, 0]])) t(i, c)
ORDER BY i
----
1	1
2	1
3	2
4	1
5	2

# The same centroids for every row, as a scalar subquery and as a one-row cross join.
statement ok
CREATE TABLE cents AS SELECT [[0, 0], [4, 0]]::FLOAT[][] AS c;

query II
SELECT list(a.label ORDER BY i), list(b.label ORDER BY i)
FROM (SELECT i, emeans_assign(v, (SELECT c FROM cents)) AS a, emeans_assign(v, cents.c) AS b FROM pts, cents)
----
[1, 1, 1, 2, 2, 2]	[1, 1, 1, 2, 2, 2]

# NULL in either argument gives NULL, and NULL rows survive materialisation.
statement ok
CREATE TABLE assigned AS
SELECT emeans_assign(v, c) AS a
FROM (VALUES ([1, 1]::DOUBLE[], [[0, 0]]::DOUBLE[][]), (NULL, [[0, 0]]), ([1, 1], NULL)) t(v, c);

query III
SELECT a IS NULL, a.label IS NULL, a.sq_distance FROM assigned ORDER BY 1, 3
----
false	false	2.0
true	true	NULL
true	true	NULL

statement error
SELECT emeans_assign([1, 2, 3], [[0, 0]])
----
the vector has 3 elements, the centroids 2

statement error
SELECT emeans_assign([]::DOUBLE[], [[0, 0]])
----
the vector is empty

statement error
SELECT emeans_assign([1, 'inf'::DOUBLE], [[0, 0]])
----
vector 1 contains NaN or infinity

statement error
SELECT emeans_assign([1, 1], [[0, 0], [1]])
----
vector 2 has 1 elements, expected 2

statement error
SELECT emeans_assign([1, 1], []::DOUBLE[][])
----
centroids has no vectors
