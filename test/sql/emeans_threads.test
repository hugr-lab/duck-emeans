# name: test/sql/emeans_threads.test
# description: emeans and emeans_assign running on many threads at once give the same results as on one
# group: [emeans]

require emeans

# DuckDB parallelises a table scan by row group (122,880 rows). 500,000 small clusterings fill 5 row
# groups, so with 8 threads the calls really run concurrently.
statement ok
CREATE TABLE many AS
SELECT g, list_transform(range(8), lambda j: [(j // 4) * 10 + sin(g * 1.3 + j), cos(g * 0.7 + j)]) AS x
FROM range(500000) t(g);

query I
SELECT count(DISTINCT row_group_id) >= 4 FROM pragma_storage_info('many')
----
true

statement ok
SET threads = 1;

statement ok
CREATE TABLE r1 AS SELECT g, emeans(x, 2, 2.0, g % 7) AS r, emeans_assign(x[1], x[5:6]) AS a FROM many;

statement ok
SET threads = 8;

statement ok
CREATE TABLE r8 AS SELECT g, emeans(x, 2, 2.0, g % 7) AS r, emeans_assign(x[1], x[5:6]) AS a FROM many;

query I
SELECT count(*) FROM r1 JOIN r8 USING (g) WHERE r1.r IS DISTINCT FROM r8.r OR r1.a IS DISTINCT FROM r8.a
----
0

query I
SELECT count(*) FROM r8
----
500000

# emeans_agg: 50 groups of 12,000 projected points each, combined from partial states on many threads, give
# the same centroids as on one thread (the points are sorted, and stored relative to the smallest
# coordinates, before clustering).
statement ok
CREATE TABLE geo AS
SELECT i % 50 AS grp, ('POINT(' || (674000 + (i % 3) * 5000 + (i % 7) * 0.5) || ' ' ||
                        (6580000 + (i % 3) * 5000 + (i % 11) * 0.5) || ')')::GEOMETRY AS g
FROM range(600000) t(i);

statement ok
SET threads = 1;

statement ok
CREATE TABLE a1 AS SELECT grp, emeans_agg(g, 3) AS r FROM geo GROUP BY grp;

statement ok
SET threads = 8;

statement ok
CREATE TABLE a8 AS SELECT grp, emeans_agg(g, 3) AS r FROM geo GROUP BY grp;

query I
SELECT count(*) FROM a1 JOIN a8 USING (grp) WHERE a1.r IS DISTINCT FROM a8.r
----
0

# One call split into parts on DuckDB's scheduler. Lloyd mode takes the whole input as one batch: 4,000
# rows x k 64 x d 32 = 8.2e6 units of work, two parts of at least 4e6 each, so with emeans_threads = 4 the
# batch is split and its parts run as tasks. The frames are the same as on one part.
statement ok
CREATE TABLE wide AS
SELECT list([((i * 7919 + j * 104729) % 1000) / 1000.0 FOR j IN range(32)]::FLOAT[]) AS x FROM range(4000) r(i);

statement ok
SET emeans_threads = 1;

statement ok
CREATE TABLE w1 AS SELECT emeans_trace(x, NULL, 64, 2.0, 1, 'lloyd', NULL, NULL, NULL) AS t FROM wide;

statement ok
SET emeans_threads = 4;

statement ok
CREATE TABLE w4 AS SELECT emeans_trace(x, NULL, 64, 2.0, 1, 'lloyd', NULL, NULL, NULL) AS t FROM wide;

query I
SELECT count(*) FROM w1, w4 WHERE w1.t IS DISTINCT FROM w4.t
----
0

statement ok
RESET emeans_threads;
